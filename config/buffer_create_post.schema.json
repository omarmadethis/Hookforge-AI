{
 "_source": "user-Buffer create_post inputSchema via GetDynamicTools (read-only), 2026-10-20 5:10 PM PT. Top level, assets and metadata.facebook/instagram transcribed verbatim; other platforms' metadata omitted (not routed). Refresh with the same read-only call if Buffer changes its schema.",
 "_tool_notes": [
  "Facebook: requires metadata.facebook.type",
  "Instagram: requires image or video asset + metadata.instagram.type",
  "asset url: direct http(s) file URL, publicly downloadable; not a local path, share/preview page or expiring host",
  "a link preview card is not an asset: do not send linkAttachment with a non-empty assets array",
  "never set thumbnailUrl on video assets (use metadata.thumbnailOffset)"
 ],
