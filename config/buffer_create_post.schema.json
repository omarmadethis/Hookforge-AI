           {
            "type": "object",
            "properties": {
             "url": {
              "anyOf": [
               {
                "type": "string",
                "format": "uri"
               },
               {
                "type": "string",
                "const": ""
               }
              ]
             }
            },
            "required": [
             "url"
            ]
           }
          ]
         }
        },
        "required": [
         "url"
        ]
       }
      },
      "required": [
       "type"
      ]
     }
    }
   },
   "saveToDraft": {
    "type": "boolean"
   },
   "ideaId": {
    "type": "string",
    "pattern": "^[a-f\\d]{24}$"
