     "type": "string",
     "pattern": "^[a-f\\d]{24}$"
    }
   },
   "assets": {
    "type": "array",
    "items": {
     "anyOf": [
      {
       "type": "object",
       "properties": {
        "image": {
         "type": "object",
         "properties": {
          "url": {
           "type": "string",
           "format": "uri"
          },
          "thumbnailUrl": {
           "anyOf": [
            {
             "type": "string",
             "format": "uri"
            },
            {
             "type": "string",
             "const": ""
            }
           ]
          },
          "metadata": {
           "type": "object",
           "properties": {
            "altText": {
             "type": "string"
            },
            "animatedThumbnail": {
             "type": "string",
             "format": "uri"
            },
            "userTags": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "handle": {
                "type": "string"
               },
               "x": {
                "type": "number"
               },
               "y": {
                "type": "number"
               }
              },
              "required": [
