      },
      "required": [
       "type",
       "shouldShareToFeed"
      ]
     },
     "facebook": {
      "type": "object",
      "properties": {
       "type": {
        "type": "string",
        "enum": [
         "post",
         "reel",
         "story"
        ]
       },
       "firstComment": {
