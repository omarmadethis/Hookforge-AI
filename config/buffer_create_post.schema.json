               "x",
               "y"
              ]
             }
            }
           },
           "required": [
            "altText"
           ]
          }
         },
         "required": [
          "url"
         ]
        }
       },
       "required": [
        "image"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "video": {
         "type": "object",
         "properties": {
          "url": {
           "type": "string",
           "format": "uri"
          },
          "metadata": {
           "type": "object",
           "properties": {
            "thumbnailOffset": {
             "type": "integer",
             "minimum": -2147483648,
             "maximum": 2147483647
            },
            "title": {
             "type": "string"
            }
           }
          }
         },
         "required": [
          "url"
         ]
        }
       },
       "required": [
        "video"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "document": {
         "type": "object",
         "properties": {
          "url": {
           "type": "string",
           "format": "uri"
          },
          "title": {
           "type": "string"
          },
          "thumbnailUrl": {
           "anyOf": [
            {
             "type": "string",
             "format": "uri"
            },
            {
             "type": "string",
             "const": ""
            }
           ]
          }
         },
         "required": [
          "url",
          "title",
          "thumbnailUrl"
         ]
        }
       },
       "required": [
        "document"
       ],
       "additionalProperties": false
      }
     ]
    }
   },
   "metadata": {
    "type": "object",
    "properties": {
