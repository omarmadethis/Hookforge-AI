# Copy to .env (gitignored) and fill in. NEVER commit .env or paste tokens into chat, docs or code.
# Hookforge does not need API keys for generation or publishing when you run it through an agent with the
# Higgsfield and Buffer connectors (they authenticate via OAuth in the agent app). These are optional.

# Optional: Meta Graph token for reading your own page Insights (results feed / caption swap). Read-only scopes.
META_TOKEN=
# Optional: GitHub token for pushing your own fork from a headless box (keep it in env only).
GH_TOKEN=
# Optional overrides
HOOKFORGE_WORKSPACE=/workspace
HOOKFORGE_INSIGHTS_DIR=
HOOKFORGE_USE_DB=0
